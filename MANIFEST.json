{
  "name": "Agent0-Context-Framework",
  "version": "2026-05-15",
  "repo": "sechang11/Agent0-Context-Framework",
  "branch": "main",
  "raw_base": "https://raw.githubusercontent.com/sechang11/Agent0-Context-Framework/main/",

  "classes": {
    "additive": "Pure framework content. No PROJECT slots. Safe to overwrite on update — the framework owns this file.",
    "template": "Contains PROJECT: slots that the user fills in at adoption time. Update only copies if the file is MISSING locally; never overwrites a customized template."
  },

  "files": [
    { "path": ".claude/commands/adopt-framework.md",    "class": "additive" },
    { "path": ".claude/commands/spec.md",               "class": "additive" },
    { "path": ".claude/commands/agents.md",             "class": "additive" },
    { "path": ".claude/commands/report.md",             "class": "additive" },
    { "path": ".claude/commands/update-framework.md",   "class": "additive" },

    { "path": ".github/prompts/adopt-framework.prompt.md",  "class": "additive" },
    { "path": ".github/prompts/spec.prompt.md",             "class": "additive" },
    { "path": ".github/prompts/agents.prompt.md",           "class": "additive" },
    { "path": ".github/prompts/report.prompt.md",           "class": "additive" },
    { "path": ".github/prompts/update-framework.prompt.md", "class": "additive" },

    { "path": ".claude/agents/architect.md",                  "class": "additive" },
    { "path": ".claude/agents/software-engineer.md",          "class": "additive" },
    { "path": ".claude/agents/code-reviewer.md",              "class": "additive" },
    { "path": ".claude/agents/security-reviewer.md",          "class": "additive" },
    { "path": ".claude/agents/test-engineer.md",              "class": "additive" },
    { "path": ".claude/agents/_domain-expert-template.md",    "class": "template" },

    { "path": ".github/agents/architect.agent.md",                  "class": "template" },
    { "path": ".github/agents/software-engineer.agent.md",          "class": "template" },
    { "path": ".github/agents/code-reviewer.agent.md",              "class": "template" },
    { "path": ".github/agents/security-reviewer.agent.md",          "class": "template" },
    { "path": ".github/agents/test-engineer.agent.md",              "class": "template" },
    { "path": ".github/agents/_domain-expert-template.agent.md",    "class": "template" }
  ],

  "commands_table": [
    { "command": "/adopt-framework",   "purpose": "One-shot adoption — explore the codebase, interview, fill PROJECT slots" },
    { "command": "/spec",              "purpose": "Generate `requirements.md` + `design.md` + `tasks.md` for non-trivial work" },
    { "command": "/agents",            "purpose": "List the agents assigned to this project, one specialty line each" },
    { "command": "/report",            "purpose": "Convene every agent for a roundtable progress review; writes `PROGRESS_REPORT.md`" },
    { "command": "/update-framework",  "purpose": "Pull the latest additive files (commands, agent shims, manifest) from the public framework repo" }
  ],

  "changelog": [
    {
      "version": "2026-05-15",
      "notes": [
        "Added /agents — roster lookup, one specialty line per agent.",
        "Added /report — roundtable progress review, writes timestamped PROGRESS_REPORT.md.",
        "Added /update-framework — pull additive updates from GitHub via curl.",
        "First versioned manifest. Prior to this, the framework was distributed by copy-paste."
      ]
    }
  ]
}
